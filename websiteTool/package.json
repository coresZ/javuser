{
  "name": "webpage-object-toolkit",
  "version": "0.4.7",
  "description": "网页对象工具库 — 取选任意网页元素，识别对象类型，绑定动作；支持远程规则订阅与导入导出",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node --watch build.mjs",
    "version:bump": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const [a,b,c]=p.version.split('.').map(Number);p.version=[a,b,c+1].join('.');fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');console.log(p.version)\""
  },
  "keywords": [
    "userscript",
    "tampermonkey",
    "element-picker",
    "greasyfork"
  ],
  "author": "cores",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
